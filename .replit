modules = ["python-base-3.13", "nodejs-24"]

[nix]
channel = "stable-25_05"
packages = ["freetype", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "tcl", "tk", "zlib", "wrangler_1"]

[userenv]

[userenv.shared]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TG Selling App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Flaticon Proxy"

[[workflows.workflow]]
name = "TG Selling App"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd 'tg selling' && npx vite --host"
waitForPort = 5173

[[workflows.workflow]]
name = "Flaticon Proxy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd 'tg selling/flaticon-proxy' && python3 server.py"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 4173
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 5173
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "static"
run = ["npx", "vite", "--host"]
build = ["bash", "-c", "cd 'tg selling' && npm run build"]
publicDir = "tg selling/dist"
