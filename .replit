[userenv]

[userenv.shared]
VITE_FIREBASE_API_KEY = "AIzaSyCyWc2-oVF43E-IvvCUGXqyT4cVg6-DnIk"
VITE_FIREBASE_APP_ID = "1:114813760320:web:3468b7e8a621a9fd05c0a5"
VITE_FIREBASE_AUTH_DOMAIN = "panleseling.firebaseapp.com"
VITE_FIREBASE_DATABASE_URL = "https://panleseling-default-rtdb.firebaseio.com"
VITE_FIREBASE_MESSAGING_SENDER_ID = "114813760320"
