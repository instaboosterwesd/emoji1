{
  "installCommand": "npm install",
  "buildCommand": "cd \"tg selling\" && npm run build",
  "outputDirectory": "tg selling/dist",
  "rewrites": [
    { "source": "/low", "destination": "/low/index.html" },
    { "source": "/low/(.*)", "destination": "/low/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
