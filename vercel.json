{
  "rootDirectory": "tg selling",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/low", "destination": "/low/index.html" },
    { "source": "/low/(.*)", "destination": "/low/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
